# Gemini（推荐与当前项目配置保持一致）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 使用 CloseAI Gemini 原生协议中转时启用；Google 官方 Key 可删除这一行
GEMINI_BASE_URL=https://api.openai-proxy.org/google
GEMINI_ENABLE_GROUNDING=false

# 或者改用 OpenAI：删除上面的 Gemini 配置并启用下面两行
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

# 单个 IP 每小时最多调用生成接口的次数
REQUESTS_PER_HOUR=30
